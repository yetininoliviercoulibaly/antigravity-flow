# Build stage
FROM python:3.9-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project
COPY . .

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=<%= port %>

# Expose port
EXPOSE <%= port %>

# Run command
CMD <%= startCommand %>
