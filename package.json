{
  "name": "antigravity-flow",
  "version": "1.0.0",
  "description": "Universal AI Context Generator & Workflow CLI for Cursor, Windsurf, and Antigravity.",
  "main": "dist/src/core/index.js",
  "bin": {
    "ag-flow": "./dist/bin/ag-flow.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.js && tsc && node scripts/copy-assets.js",
    "start": "node dist/bin/ag-flow.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "cli",
    "agent",
    "workflow",
    "ai",
    "automation",
    "rigor",
    "antigravity"
  ],
  "author": "Coulibaly Yetinin Olivier",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "ejs": "^3.1.10",
    "fs-extra": "^11.3.3",
    "inquirer": "^8.2.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
